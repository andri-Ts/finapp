generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
    moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType{
  EXPENSE
  INCOME
}

enum TransactionType{
  EXPENSE
  INCOME
  TRANSFER
}

model User {
  id           String   @id @default(cuid())
  pseudo       String
  email        String   @unique
  passwordHash String
  currency     String   @default("EUR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account Account[] // 1 user ---> N accounts
  category Category[]
}

model Account{
  id String @id @default(cuid())
  name String
  type String // Type du compte (BANK, CASH, SAVINGS...)
  currency String @default("EUR")
  initialBalance Decimal @default(0) // Decimal pour avoir un nombre précis et non avec des virgules à rallonge
  currentBalance Decimal @default(0)
  icon String?
  color String?
  displayOrder Int @default(0) // le 1er compte afficher à l'user
  isDefault Boolean @default(false)
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    // ---- Relations --------
  userId String // Clé étrangère : identifiant du propriétaire du compte
  // Cette ligne n'ajoute pas une colonne supplémentaire: la clé étrangère est stockée dans la colonne userId.cette clé étrangère pointe vers le id de la table User.
  user User @relation(fields: [userId], references: [id])
  transaction Transaction[]
}

model Category{
  id String @id @default(cuid())
  name String
  type CategoryType
  icon String?
  color String?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- Relations --------
  userId String
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, name]) // La combinaison userId + name doit être unique -> un utilisateur ne peut avoir un même nom de catégorie
  transaction Transaction[]
}

model Transaction {
  id String @id @default(cuid())
  amount Decimal // Montant toujours positif
  type TransactionType
  description String
  note String?
  transactionDate DateTime // Date réel de la date
  transferGroupId String? // Lie les deux transations d'un transfert
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- Relations --------
  accountId String // Compte concerné
  account Account @relation(fields: [accountId], references: [id])
  categoryId String? // Valeur peut être absent car Transfert n'a pas besoin de categorie
  category Category? @relation(fields: [categoryId], references: [id])
}
